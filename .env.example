# ── 服务 ─────────────────────────────────────────────
LIFEOS_PORT=8787

# ── MySQL ────────────────────────────────────────────
# 密码含特殊字符时需要 URL 编码
LIFEOS_DATABASE_URL=mysql+aiomysql://lifeos:CHANGE_ME@127.0.0.1:3306/lifeos?charset=utf8mb4
LIFEOS_TEST_DATABASE_URL=mysql+aiomysql://lifeos:CHANGE_ME@127.0.0.1:3306/lifeos_test?charset=utf8mb4

# ── 大模型（可选）────────────────────────────────────
# 不填也能跑：回顾页会退化成「本地统计版」摘要。
# 兼容任何 OpenAI Chat Completions 协议的服务。
LIFEOS_LLM_API_KEY=
LIFEOS_LLM_BASE_URL=https://api.deepseek.com/v1
LIFEOS_LLM_MODEL=deepseek-chat
# 某些网关（如 OpenCode Go）需要稳定的会话 ID；普通服务会忽略
LIFEOS_LLM_SESSION_ID=lifeos

# OpenCode Go 示例：
# LIFEOS_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LIFEOS_LLM_MODEL=deepseek-v4.1-flash
