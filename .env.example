# ── 服务 ─────────────────────────────────────────────
# 服务端口（手机和电脑都用 http://<你的内网IP>:8787 访问）
LIFEOS_PORT=8787
# 数据目录，默认 ./data
# LIFEOS_DATA_DIR=./data

# ── 大模型（可选）────────────────────────────────────
# 不填也能跑：回顾页会退化成「本地统计版」摘要。
# 兼容任何 OpenAI Chat Completions 协议的服务。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 其他常见组合：
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   阿里通义     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   本地 Ollama LLM_BASE_URL=http://127.0.0.1:11434/v1      LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama
